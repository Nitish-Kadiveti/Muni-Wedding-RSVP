# Copy this file to .env.local for local development,
# and add the same variables in Vercel Project Settings -> Environment Variables for production.

# Required only if you want RSVP submissions saved to a database.
# Without these, the RSVP form still works end-to-end, it just won't persist submissions
# (they are logged in the Vercel function logs instead).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
